# Copy to ${ZOOID_HOME}/.env (chmod 600); never commit the real file.
# Read by deploy.sh and passed to the zooid daemon (env_file).
# Format rules and every key: deploy/README.md.

# --- Required ---
# Matrix server name; host part of user_namespace in zooid.yaml. Permanent:
# it is embedded in every user and room ID (prod: fabrium.net).
SERVER_NAME=<server name, e.g. fabrium.net>
# Caddy site address: a domain enables auto-HTTPS; ":80" or "http://<domain>" for plain HTTP.
SITE_ADDRESS=<site address, e.g. fabrium.net>
# Browser-facing homeserver URL (written to config.json; also the push gateway base).
HOMESERVER_URL=<homeserver url, e.g. https://fabrium.net>
# Appservice tokens shared by tuwunel and zooid.
MATRIX_AS_TOKEN=<run: openssl rand -hex 32>
MATRIX_HS_TOKEN=<run: openssl rand -hex 32>

# --- Optional (defaults shown) ---
# WORKFORCE_SPACE=dev
# APPSERVICE_PORT=9000
# TUWUNEL_IMAGE=ghcr.io/matrix-construct/tuwunel@sha256:678b7f5350e06a41614444497c587da9dddf66767e4068a27480402f3c1367d0
# TUWUNEL_BIND=127.0.0.1:8448
# HTTP_PORT=80
# HTTPS_PORT=443
# COMPOSE_PROJECT_NAME=fabrium

# --- Agent secrets (referenced as ${VAR} in zooid.yaml) ---
GH_TOKEN=<github token>
HAVEN_API_KEY=<haven api key>

# --- VM management (web UI; see "VM management" in deploy/README.md) ---
# The API is off unless the control plane URL and its key file are both set.
# FABRIUM_CONTROL_PLANE_URL=https://control.example.org
# Absolute path (no ~) of a file with the tenant API key and nothing else, mode 600. backup.sh includes it under ZOOID_HOME.
# FABRIUM_CONTROL_PLANE_KEY_FILE=/home/ubuntu/zooid/control-plane-api-key
# Haven model of new VMs. Without it, create answers 503.
# FABRIUM_HAVEN_MODEL=glm-5-3
# Rooms of new agents, comma separated. Put the value in single quotes. Default: #general
# FABRIUM_VM_ROOMS='#general'
