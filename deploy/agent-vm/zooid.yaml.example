# Agent VM config, rendered by deploy/add-workstation.sh into ${ZOOID_HOME}/workstations/<workstation>/workforce/zooid.yaml
# (copy that bundle to the VM; see deploy/README.md). The quotes keep the names strings in YAML.
# zooid reads "${HOMESERVER_URL}" from the daemon environment (~/zooid/.env, ~/zooid/secrets.env).
workstation: '${WORKSTATION}'
# The agent is a process of the VM, with the access of the VM user (Docker, sudo).
runtime: local
transports:
  matrix:
    homeserver: "${HOMESERVER_URL}"
    # The VM reads with /sync and opens no port.
    mode: client
    sender_localpart: '${WORKSTATION}'
    user_namespace: '@${WORKSTATION}\..*:${SERVER_NAME}'   # host part: SERVER_NAME, dots not escaped
    space: '${WORKFORCE_SPACE}'
agents:
  # Persona and project are in the roster that add-workstation.sh publishes.
  # The rooms must stay equal to its --room values.
  '${AGENT_NAME}':
    acp: ${AGENT_ACP}
    matrix: { display_name: '${AGENT_NAME}', rooms: [${AGENT_ROOMS}], trigger: mention }

# Optional, not recommended: run the harness in a container to pin its version.
# Replace `runtime: local` above with `runtime: docker` and add this block.
# The agent then cannot use the VM directly or start other containers.
# container:
#   image: ghcr.io/zooid-ai/agent-claude-code@sha256:<digest>
