[Unit]
Description=Drop inbound IPv4 TCP packets with IP options
# Load before the network comes up, like the distro's nftables.service.
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/nftables.d-ipopts-drop.nft
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
